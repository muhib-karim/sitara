<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The deterministic capture entry point is absent from release source sets.
             It resizes for the keyboard like MainActivity, so the Search capture sees the same insets after the keyboard closes. -->
        <activity
            android:name=".DeviceCaptureActivity"
            android:exported="true"
            android:theme="@style/Theme.Sitara"
            android:windowSoftInputMode="adjustResize" />
        <!-- Decodes a bundled drum track and logs its tempo, so Device screens checks automix's decoding on a real Android. -->
        <activity
            android:name=".AutomixCheckActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
